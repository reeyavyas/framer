import * as React from "react"
import { addPropertyControls, ControlType } from "framer"

/**
 * FocusGuide
 * A reusable "click here" overlay. Place it as its own layer directly
 * above any frame or component you want to draw attention to, then
 * resize it to match.
 *
 * Pointer events:
 *  - "None" (default): fully pass-through — taps land on whatever is
 *    underneath, exactly as before. Use this when the glow is just a
 *    visual cue over your own real, already-interactive UI element.
 *  - "Auto": the glow itself becomes clickable. Pair with the Link
 *    field to make tapping the glow navigate directly — useful when
 *    there's nothing underneath to click, or when you want the glow's
 *    whole area (not just the real element's exact bounds) to count
 *    as the tap target.
 *
 * Appear behavior:
 *  - "immediate": visible right away
 *  - "delay": hidden on load, fades in after N seconds
 *  - "scroll": hidden until scrolled into the viewport
 */

type Variant = "static" | "breathing" | "ripple"
type Shape = "rectangle" | "circle" | "pill"
type AppearStyle = "fade" | "fadeSlideUp" | "scaleIn"
type AppearTrigger = "immediate" | "delay" | "scroll"
type PointerMode = "none" | "auto"

interface Props {
    variant: Variant
    shape: Shape
    color: string
    cornerRadius: number
    intensity: number
    appearTrigger: AppearTrigger
    delaySeconds: number
    appearStyle: AppearStyle
    replayEachTime: boolean
    pointerEvents: PointerMode
    link?: any
    debugLink: boolean
    style?: React.CSSProperties
}

// Framer's Link control can hand back a plain string (typed URL) or
// an object (internal page reference), depending on what was picked.
// Normalize either shape into a usable href.
function resolveLink(link: any): string | undefined {
    if (!link) return undefined
    if (typeof link === "string") return link
    return link.href || link.path || link.url || undefined
}

export default function FocusGuide(props: Props) {
    const {
        variant,
        shape,
        color,
        cornerRadius,
        intensity,
        appearTrigger,
        delaySeconds,
        appearStyle,
        replayEachTime,
        pointerEvents,
        link,
        debugLink,
        style,
    } = props

    const radius =
        shape === "circle" ? "50%" : shape === "pill" ? 999 : cornerRadius

    const glowBlur = 10 + intensity * 3
    const glowSpread = 1 + intensity

    const ref = React.useRef<HTMLDivElement>(null)
    const [isVisible, setIsVisible] = React.useState(
        appearTrigger === "immediate"
    )

    React.useEffect(() => {
        if (appearTrigger !== "delay") return
        setIsVisible(false)
        const t = setTimeout(
            () => setIsVisible(true),
            Math.max(delaySeconds, 0) * 1000
        )
        return () => clearTimeout(t)
    }, [appearTrigger, delaySeconds])

    React.useEffect(() => {
        if (appearTrigger !== "scroll" || !ref.current) return
        const el = ref.current
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    setIsVisible(true)
                    if (!replayEachTime) observer.unobserve(el)
                } else if (replayEachTime) {
                    setIsVisible(false)
                }
            },
            { threshold: 0.5 }
        )
        observer.observe(el)
        return () => observer.disconnect()
    }, [appearTrigger, replayEachTime])

    const appearTransform =
        appearStyle === "scaleIn"
            ? isVisible
                ? "scale(1)"
                : "scale(0.7)"
            : appearStyle === "fadeSlideUp"
              ? isVisible
                  ? "translateY(0)"
                  : "translateY(14px)"
              : undefined

    const outerStyle: React.CSSProperties = {
        ...style,
        pointerEvents: pointerEvents === "auto" && isVisible ? "auto" : "none",
        position: "relative",
        opacity: isVisible ? 1 : 0,
        transform: appearTransform,
        transition: "opacity 0.45s ease, transform 0.45s ease",
    }

    function handleOuterClick(e: React.MouseEvent) {
        // Never let a click on FocusGuide bubble up to an unrelated
        // ancestor's own link — this component owns the click once
        // it's the hit target.
        if (pointerEvents === "auto" && isVisible) e.stopPropagation()
    }

    let content: React.ReactNode

    if (variant === "static") {
        content = (
            <div
                style={{
                    position: "absolute",
                    inset: 0,
                    borderRadius: radius,
                    border: `2px solid ${color}`,
                    boxShadow: `0 0 ${glowBlur}px ${glowSpread}px ${color}`,
                }}
            />
        )
    } else if (variant === "breathing") {
        content = (
            <>
                <style>{`
                    @keyframes fg-breathe {
                        0%, 100% { opacity: 0.45; transform: scale(0.97); }
                        50% { opacity: 1; transform: scale(1.03); }
                    }
                `}</style>
                <div
                    style={{
                        position: "absolute",
                        inset: 0,
                        borderRadius: radius,
                        border: `2px solid ${color}`,
                        boxShadow: `0 0 ${glowBlur}px ${glowSpread}px ${color}`,
                        animation: isVisible
                            ? "fg-breathe 1.8s ease-in-out infinite"
                            : "none",
                    }}
                />
            </>
        )
    } else {
        content = (
            <>
                <style>{`
                    @keyframes fg-ripple {
                        0% { transform: scale(1); opacity: 0.55; }
                        100% { transform: scale(1.4); opacity: 0; }
                    }
                `}</style>
                {[0, 0.6, 1.2].map((delay) => (
                    <div
                        key={delay}
                        style={{
                            position: "absolute",
                            inset: 0,
                            borderRadius: radius,
                            border: `2px solid ${color}`,
                            animation: isVisible
                                ? "fg-ripple 1.8s ease-out infinite"
                                : "none",
                            animationDelay: `${delay}s`,
                        }}
                    />
                ))}
                <div
                    style={{
                        position: "absolute",
                        inset: 0,
                        borderRadius: radius,
                        border: `2px solid ${color}`,
                        opacity: 0.9,
                    }}
                />
            </>
        )
    }

    const resolvedLink = resolveLink(link)

    const clickLayer =
        pointerEvents === "auto" && resolvedLink ? (
            <a
                href={resolvedLink}
                data-focus-link={resolvedLink}
                style={{
                    position: "absolute",
                    inset: 0,
                    display: "block",
                    borderRadius: radius,
                }}
                aria-label="Go to next step"
            />
        ) : null

    return (
        <div ref={ref} style={outerStyle} onClick={handleOuterClick}>
            {content}
            {clickLayer}
            {debugLink && (
                <div
                    style={{
                        position: "absolute",
                        top: "100%",
                        left: 0,
                        marginTop: 4,
                        background: "#000",
                        color: "#0f0",
                        fontSize: 10,
                        fontFamily: "monospace",
                        padding: "2px 6px",
                        whiteSpace: "nowrap",
                        zIndex: 999999,
                    }}
                >
                    raw: {JSON.stringify(link)} | resolved:{" "}
                    {String(resolvedLink)}
                </div>
            )}
        </div>
    )
}

FocusGuide.defaultProps = {
    variant: "breathing",
    shape: "rectangle",
    color: "#7F77DD",
    cornerRadius: 12,
    intensity: 2,
    appearTrigger: "delay",
    delaySeconds: 2,
    appearStyle: "fadeSlideUp",
    replayEachTime: false,
    pointerEvents: "none",
    debugLink: false,
}

addPropertyControls(FocusGuide, {
    variant: {
        type: ControlType.Enum,
        title: "Style",
        options: ["static", "breathing", "ripple"],
        optionTitles: ["Soft glow", "Breathing pulse", "Ripple ping"],
        defaultValue: "breathing",
    },
    shape: {
        type: ControlType.Enum,
        title: "Shape",
        options: ["rectangle", "circle", "pill"],
        optionTitles: ["Rectangle", "Circle", "Pill"],
        defaultValue: "rectangle",
    },
    color: {
        type: ControlType.Color,
        title: "Color",
        defaultValue: "#7F77DD",
    },
    cornerRadius: {
        type: ControlType.Number,
        title: "Corner radius",
        min: 0,
        max: 999,
        defaultValue: 12,
        hidden: (props) => props.shape !== "rectangle",
    },
    intensity: {
        type: ControlType.Number,
        title: "Glow intensity",
        min: 0,
        max: 5,
        step: 1,
        defaultValue: 2,
    },
    appearTrigger: {
        type: ControlType.Enum,
        title: "Appear",
        options: ["immediate", "delay", "scroll"],
        optionTitles: ["Immediately", "After delay", "On scroll into view"],
        defaultValue: "delay",
    },
    delaySeconds: {
        type: ControlType.Number,
        title: "Delay (sec)",
        min: 0,
        max: 30,
        step: 0.5,
        defaultValue: 2,
        hidden: (props) => props.appearTrigger !== "delay",
    },
    appearStyle: {
        type: ControlType.Enum,
        title: "Appear style",
        options: ["fade", "fadeSlideUp", "scaleIn"],
        optionTitles: ["Fade", "Fade + rise", "Scale in"],
        defaultValue: "fadeSlideUp",
        hidden: (props) => props.appearTrigger === "immediate",
    },
    replayEachTime: {
        type: ControlType.Boolean,
        title: "Replay each time",
        defaultValue: false,
        enabledTitle: "On",
        disabledTitle: "Off",
        hidden: (props) => props.appearTrigger !== "scroll",
    },
    pointerEvents: {
        type: ControlType.Enum,
        title: "Pointer events",
        options: ["none", "auto"],
        optionTitles: ["None (pass through)", "Auto (clickable)"],
        defaultValue: "none",
    },
    link: {
        type: ControlType.Link,
        title: "Link",
        hidden: (props) => props.pointerEvents !== "auto",
    },
    debugLink: {
        type: ControlType.Boolean,
        title: "Debug link",
        defaultValue: false,
        enabledTitle: "On",
        disabledTitle: "Off",
        hidden: (props) => props.pointerEvents !== "auto",
    },
})
